<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.WargaHubP04.Text" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/p04_slate</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Widget.WargaHubP04.Title" parent="Widget.WargaHubP04.Text">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/p04_navy</item>
    </style>

    <style name="Widget.WargaHubP04.Button" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/p04_white</item>
        <item name="backgroundTint">@color/p04_navy</item>
    </style>
