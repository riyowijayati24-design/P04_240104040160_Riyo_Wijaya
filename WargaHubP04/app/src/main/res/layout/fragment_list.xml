<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/page_padding">

    <TextView
        style="@style/Widget.WargaHubP04.Text"
        android:text="@string/list_help" />

    <TextView
        android:id="@+id/tvJumlah"
        style="@style/Widget.WargaHubP04.Text"
        android:accessibilityLiveRegion="polite" />

    <Button
        android:id="@+id/btnModeKosong"
        style="@style/Widget.WargaHubP04.Button"
        android:text="@string/try_empty" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLaporan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/item_gap" />

        <ScrollView
            android:id="@+id/emptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <TextView
                style="@style/Widget.WargaHubP04.Text"
                android:paddingTop="16dp"
                android:text="@string/empty_message" />
        </ScrollView>

    </FrameLayout>
</LinearLayout>